{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Funding registry entry",
  "type": "object",
  "required": ["id", "slug", "name", "funder", "url", "country", "type", "deadline", "deadline_confidence", "tier", "fit_score"],
  "properties": {
    "id": {"type": "string", "description": "sha1 of normalized name+funder (12 chars)"},
    "slug": {"type": "string", "description": "directory name under funding/applications/"},
    "category": {"type": "string", "description": "key from categories.json"},
    "name": {"type": "string"}, "funder": {"type": "string"}, "url": {"type": "string"}, "country": {"type": "string"},
    "type": {"type": "string", "enum": ["postdoc_fellowship", "research_grant", "training_award", "faculty_position", "society_fellowship", "startup_nondilutive", "accelerator_or_program", "competition_or_prize", "compute_or_credits", "standards_participation", "other"]},
    "applicant_entity": {"type": "string", "enum": ["individual", "institution", "company", "either"]},
    "deadline": {"type": "string", "description": "YYYY-MM-DD | rolling | expected YYYY-MM (unconfirmed) | unknown"},
    "deadline_confidence": {"type": "string", "enum": ["high", "medium", "low"]},
    "internal_or_referee_deadlines": {"type": "string"},
    "cycle_note": {"type": "string"},
    "amount": {"type": "string"}, "duration": {"type": "string"},
    "eligibility_summary": {"type": "string"},
    "citizenship_requirement": {"type": "string"}, "years_since_phd_limit": {"type": "string"}, "needs_host_or_nominator": {"type": "string"},
    "eligibility_flags": {"type": "array", "items": {"type": "string"}},
    "risks_and_flags": {"type": "array", "items": {"type": "string"}},
    "required_documents": {"type": "array", "items": {"type": "string"}},
    "verdict": {"type": "string", "enum": ["scouted", "confirmed", "corrected", "unverifiable", "ineligible", "closed_for_cycle", "discontinued"]},
    "tier": {"type": ["string", "null"], "enum": ["A", "B", "C", "D", null]},
    "tier_rationale": {"type": "string"},
    "fit_score": {"type": "integer", "minimum": 0, "maximum": 100}, "fit_rationale": {"type": "string"},
    "evidence": {"type": "array", "items": {"type": "object", "properties": {"claim": {"type": "string"}, "quote": {"type": "string"}, "url": {"type": "string"}}}},
    "corrections": {"type": "string"},
    "next_actions": {"type": "array", "items": {"type": "string"}},
    "estimated_prep_days": {"type": "integer"},
    "sources": {"type": "array", "items": {"type": "string"}},
    "first_seen": {"type": "string"}, "last_checked": {"type": "string"},
    "status": {"type": "string", "description": "applicant-maintained: not_started | drafting | waiting_on_referees | submitted | awarded | declined"}
  }
}
